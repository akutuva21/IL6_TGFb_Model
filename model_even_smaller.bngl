begin model

begin parameters
    # Initial amounts of molecules
    TGFb_0                  1.0
    IL6_0                   0.0

    # Reversible ligand binding parameters (FIXED: PI's suggestion)
    # IL-6 Pathway
    kf_il6_bind             0.3          # IL-6 forward binding rate
    kr_il6_bind             0.05         # IL-6 reverse binding rate  
    k_act_il6r              3.0          # IL6R activation rate
    k_deact_il6r            0.01         # IL6R deactivation rate

    # TGFb Pathway  
    kf_tgfb_bind            0.05         # TGFb forward binding rate
    kr_tgfb_bind            0.2          # TGFb reverse binding rate
    k_act_tgfbr             0.8          # TGFbR activation rate
    k_deact_tgfbr           0.02         # TGFbR deactivation rate

    # SMAD3 dynamics
    k_phos_smad3            0.015        # Further reduced from 0.03 to minimize baseline SMAD3 phosphorylation
    k_dephos_smad3          0.035        # Increased from 0.02 to make SMAD3 more responsive to changes

    # STAT3 dynamics
    kf_stat3_bind           0.12         # Increased from 0.05 for stronger STAT3 response to IL6
    k_phos_stat3            0.15         # Increased from 0.08 for faster STAT3 phosphorylation
    kf_dimer                0.5          # STAT3 dimerization rate (now irreversible)
    k_dephos_stat3d         0.06         # Reduced from 0.08 to maintain STAT3 activity longer

    # SMAD3-TGFbR binding parameters
    kf_smad3_bind           0.08         # SMAD3 forward binding rate (slower than STAT3)

    # Complex formation (now irreversible)
    kf_s3s4                 0.6          # SMAD3-SMAD4 complex formation rate
    kf_s3stat3d             4.0          # SMAD3-STAT3 complex formation rate
    k_dephos_s3stat3d_complex 1.0       # Enhanced dephosphorylation of sequestered SMAD3-STAT3 complex

    # PKA activation parameters (now two-step: binding + phosphorylation)
    kf_pka_bind             1.0          # PKA binding to SMAD3/4 complex
    Kd_pka_bind             0.1          # Dissociation constant for PKA-SMAD3/4
    k_phos_pka              0.5          # Catalytic rate of PKA autophosphorylation

    # Initial amounts of cellular components
    IL6R_0                  250.0        # Further increased from 200 for even stronger IL6 response
    TGFbR_0                 40.0         # Further reduced from 60 to minimize baseline TGFb activity
    SMAD3_0                 45.0         # Further reduced from 60 to limit baseline SMAD3 pool even more
    SMAD4_0                 30.0         # Further reduced from 40 to limit SMAD3-SMAD4 complexes
    STAT3m_0                250.0        # Increased from 220 for stronger STAT3-SMAD3 crosstalk
    PKA_0                   50.0

end parameters

begin molecule types
    TGFb(r)
    IL6(r)
    IL6R(l_bind,activity~I~A,stat3_site) 
    TGFbR(l_bind,activity~I~A,smad3_site)
    SMAD3(phos~U~P,smad4_site,stat3_site,pka_site,tgfbr_site)
    SMAD4(s3_site)
    STAT3m(il6r_site,phos~U~P)
    STAT3d_active(s3_site)
    PKA(s3s4_site,phos~U~P)
end molecule types

begin seed species
    TGFb(r)                                                            TGFb_0
    IL6(r)                                                             IL6_0
    IL6R(l_bind,activity~I,stat3_site)                                 IL6R_0
    TGFbR(l_bind,activity~I,smad3_site)                                TGFbR_0
    SMAD3(phos~U,smad4_site,stat3_site,pka_site,tgfbr_site)            SMAD3_0
    SMAD4(s3_site)                                                     SMAD4_0
    STAT3m(il6r_site,phos~U)                                           STAT3m_0
    PKA(s3s4_site,phos~U)                                              PKA_0
end seed species

begin observables
    Molecules Free_IL6_obs IL6(r)
    Molecules Free_TGFb_obs TGFb(r)
    Molecules IL6R_Active IL6R(activity~A)
    Molecules TGFbR_Active TGFbR(activity~A)
    Molecules pSMAD3_obs SMAD3(phos~P)
    Molecules pSTAT3_obs STAT3m(phos~P)
    Molecules STAT3d_active_obs STAT3d_active()
    Molecules S3S4_complex_obs SMAD3(smad4_site!1,tgfbr_site).SMAD4(s3_site!1)
    Molecules S3STAT3d_complex_obs SMAD3(stat3_site!1,tgfbr_site).STAT3d_active(s3_site!1)
    Molecules PKA_active PKA(phos~P)
end observables

begin reaction rules
    # Biologically correct reversible ligand binding (FIXED: PI's suggestion)
    # 0. IL-6 Signaling Pathway
    R0a_IL6_Bind_Receptor: IL6(r) + IL6R(l_bind,activity~I) <-> IL6(r!1).IL6R(l_bind!1,activity~I) kf_il6_bind,kr_il6_bind
    R0b_Activate_IL6R: IL6(r!+).IL6R(l_bind!+,activity~I) -> IL6(r!+).IL6R(l_bind!+,activity~A) k_act_il6r
    R0c_Deactivate_IL6R: IL6(r!1).IL6R(l_bind!1,activity~A) -> IL6(r) + IL6R(l_bind,activity~I,stat3_site) k_deact_il6r

    # 0b. TGFb Signaling Pathway (similar to IL-6)
    R0e_TGFb_Bind_Receptor: TGFb(r) + TGFbR(l_bind,activity~I) <-> TGFb(r!1).TGFbR(l_bind!1,activity~I) kf_tgfb_bind,kr_tgfb_bind
    R0f_Activate_TGFbR: TGFb(r!+).TGFbR(l_bind!+,activity~I) -> TGFb(r!+).TGFbR(l_bind!+,activity~A) k_act_tgfbr
    R0g_Deactivate_TGFbR: TGFb(r!1).TGFbR(l_bind!1,activity~A) -> TGFb(r) + TGFbR(l_bind,activity~I,smad3_site) k_deact_tgfbr

    # 1. & 2. SMAD3 Dynamics
    R1a_Bind_SMAD3_TGFbR: SMAD3(phos~U,smad4_site,stat3_site,pka_site,tgfbr_site) + TGFbR(activity~A,smad3_site) -> SMAD3(phos~U,smad4_site,stat3_site,pka_site,tgfbr_site!1).TGFbR(activity~A,smad3_site!1) kf_smad3_bind
    R1b_Phos_SMAD3: SMAD3(phos~U,smad4_site,stat3_site,pka_site,tgfbr_site!1).TGFbR(activity~A,smad3_site!1) -> SMAD3(phos~P,smad4_site,stat3_site,pka_site,tgfbr_site) + TGFbR(activity~A,smad3_site) k_phos_smad3
    R2_Dephos_SMAD3: SMAD3(phos~P,smad4_site,stat3_site,pka_site,tgfbr_site) -> SMAD3(phos~U,smad4_site,stat3_site,pka_site,tgfbr_site) k_dephos_smad3

    # 3. STAT3 Pathway
    R3a_Bind_STAT3: STAT3m(il6r_site,phos~U) + IL6R(activity~A,stat3_site) -> STAT3m(il6r_site!1,phos~U).IL6R(activity~A,stat3_site!1) kf_stat3_bind
    R3b_Phos_STAT3: STAT3m(il6r_site!1,phos~U).IL6R(activity~A,stat3_site!1) -> STAT3m(il6r_site,phos~P) + IL6R(activity~A,stat3_site) k_phos_stat3
    R3c_Dimerize_pSTAT3: STAT3m(il6r_site,phos~P) + STAT3m(il6r_site,phos~P) -> STAT3d_active(s3_site) kf_dimer

    # 4. STAT3 Dephosphorylation
    R4_Dephos_STAT3d: STAT3d_active(s3_site) -> STAT3m(il6r_site,phos~U) + STAT3m(il6r_site,phos~U) k_dephos_stat3d

    # 5. & 6. Complex Formation
    R5_Bind_S3S4: SMAD3(phos~P,smad4_site,stat3_site,pka_site,tgfbr_site) + SMAD4(s3_site) -> SMAD3(phos~P,smad4_site!1,stat3_site,pka_site,tgfbr_site).SMAD4(s3_site!1) kf_s3s4
    R6_Bind_S3STAT3d: SMAD3(phos~P,smad4_site,stat3_site,pka_site,tgfbr_site) + STAT3d_active(s3_site) -> SMAD3(phos~P,smad4_site,stat3_site!1,pka_site,tgfbr_site).STAT3d_active(s3_site!1) kf_s3stat3d

    # 7. PKA Activation (biologically accurate two-step mechanism)
    R7a_Bind_PKA: SMAD3(phos~P,smad4_site!1,stat3_site,pka_site,tgfbr_site).SMAD4(s3_site!1) + PKA(s3s4_site,phos~U) <-> SMAD3(phos~P,smad4_site!1,stat3_site,pka_site!2,tgfbr_site).SMAD4(s3_site!1).PKA(s3s4_site!2,phos~U) kf_pka_bind,kf_pka_bind*Kd_pka_bind
    R7b_Phos_PKA: SMAD3(phos~P,smad4_site!1,stat3_site,pka_site!2,tgfbr_site).SMAD4(s3_site!1).PKA(s3s4_site!2,phos~U) -> SMAD3(phos~P,smad4_site!1,stat3_site,pka_site!2,tgfbr_site).SMAD4(s3_site!1).PKA(s3s4_site!2,phos~P) k_phos_pka
    R7c_Dissociate_pPKA: SMAD3(phos~P,smad4_site!1,stat3_site,pka_site!2,tgfbr_site).SMAD4(s3_site!1).PKA(s3s4_site!2,phos~P) -> SMAD3(phos~P,smad4_site!1,stat3_site,pka_site,tgfbr_site).SMAD4(s3_site!1) + PKA(s3s4_site,phos~P) k_dephos_s3stat3d_complex

    # 8. STAT3-SMAD3 Complex Sequestration (IL-6 inhibitory mechanism)
    R8_Dephos_S3STAT3d: SMAD3(phos~P,smad4_site,stat3_site!1,pka_site,tgfbr_site).STAT3d_active(s3_site!1) -> SMAD3(phos~U,smad4_site,stat3_site,pka_site,tgfbr_site) + STAT3d_active(s3_site) k_dephos_s3stat3d_complex

end reaction rules

end model

# Actions
generate_network({overwrite=>1})
simulate({method=>"ode",t_end=>100,n_steps=>1000})
writeSBML()